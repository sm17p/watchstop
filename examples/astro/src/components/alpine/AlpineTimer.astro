<div class="island-face" x-data="timer">
  <p class="label">alpine</p>
  <p class="elapsed" x-text="Math.floor(elapsed) + ' ms'"></p>
  <div class="controls">
    <button type="button" @click="toggleRun()" x-text="running ? 'Stop' : 'Start'"></button>
    <button type="button" @click="reset()">Reset</button>
  </div>
</div>
