{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "@qwik.dev/core"
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/root.tsx",
    "src/entry.dev.tsx",
    "src/entry.ssr.tsx"
  ],
  "references": [{ "path": "../core" }]
}
