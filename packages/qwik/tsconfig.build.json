{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/index.ts", "src/use-stopwatch.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/root.tsx",
    "src/entry.dev.tsx",
    "src/entry.ssr.tsx",
    "vite.config.ts"
  ]
}
